/**
 * @file wifi_secrets.h.example
 * @brief Template for the WiFi credentials.
 *
 * HOW TO USE:
 *   1. Copy this file and name the copy "wifi_secrets.h" (same folder: include/).
 *   2. Replace "YOUR_SSID" and "YOUR_PASSWORD" with the credentials of your WiFi network.
 *
 * "wifi_secrets.h" is listed in .gitignore, so your password is never committed to GitHub.
 * Do NOT write your password into this .example file - it IS committed.
 */

#pragma once

#define UDP_INTERFACE_WIFI_SSID "YOUR_SSID"     /**< WiFi SSID for UDP interface */
#define UDP_INTERFACE_WIFI_PASS "YOUR_PASSWORD" /**< WiFi password for UDP interface */
